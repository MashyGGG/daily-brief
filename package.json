{
  "name": "daily-brief",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily international tech & news brief, pushed to WeCom / Gmail by GitHub Actions.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "brief": "tsx src/index.ts",
    "brief:schedule": "tsx src/schedule/generate.ts --write",
    "check:schedule": "tsx src/schedule/generate.ts --check",
    "site:build": "tsx src/site/build.ts",
    "validate": "tsx src/index.ts --validate-only",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.1",
    "nodemailer": "^6.9.16",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
